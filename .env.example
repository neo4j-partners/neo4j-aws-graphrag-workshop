# Neo4j Aura connection (required for all modules)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password-here
NEO4J_DATABASE=neo4j

# AWS region (Workshop Studio pre-configures credentials; self-paced users set these).
# The notebooks read this name and export it as AWS_DEFAULT_REGION during setup,
# because botocore reads only AWS_DEFAULT_REGION and would otherwise fall back to
# whatever region your active AWS profile configures.
AWS_REGION=us-east-1

# Model override. The workshop default is us.anthropic.claude-sonnet-5.
# MODEL_ID=us.anthropic.claude-sonnet-5
