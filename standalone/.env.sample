# Copy to .env only when you need to override a default. A normal single-student
# deployment in us-east-1 does not need this file. Anything left blank or
# commented out falls back to the workshop default, except VPC_ID and SUBNET_ID,
# which resolve to the region's default VPC.
#
#   cp .env.sample .env
#   ./deploy.py
#
# There is nothing to configure for Neo4j. This stack never installs or hosts it.
# Participants use Neo4j Aura Free Tier, which is external to AWS.

# ---------------------------------------------------------------------------
# Stack and staging
# ---------------------------------------------------------------------------

# CloudFormation stack name.
STACK_NAME=neo4j-graphrag-workshop

# Deploy region. us-east-1 is the only region in the template's AmiByRegion map,
# so another region needs a second entry there with that region's two Amazon
# Linux 2023 AMI IDs. Nothing else is region-pinned: deploy.py resolves the
# CloudFront origin-facing prefix list by name, so the script has no allowlist.
AWS_REGION=us-east-1

# The template is staged in S3 and passed to CloudFormation by URL. Leave blank
# to use neo4j-graphrag-workshop-<account-id>-<region>, created on first run.
TEMPLATE_BUCKET=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# VPC and public subnet to launch the instance into. Every participant stack can
# share one. Leave both blank to use the region's default VPC and its first
# public subnet by AZ. Set both or neither.
#
# The subnet must auto-assign public IPs and route 0.0.0.0/0 to an internet
# gateway. The CloudFront origin is the instance's public DNS name, and the SSM
# agent needs outbound internet to register.
VPC_ID=
SUBNET_ID=

# ---------------------------------------------------------------------------
# Instance
# ---------------------------------------------------------------------------

# Linux username that owns the Code Editor server. Default: participant
CODE_EDITOR_USER=

# EC2 Name tag and hostname. Default: Neo4jGraphRAGWorkshop
INSTANCE_NAME=

# Default t4g.large. Graviton is detected from the family name, so an x86
# family such as t3.large also works and picks the x86_64 AMI. The OS is always
# Amazon Linux 2023.
INSTANCE_TYPE=

# Root EBS volume size in GB. Default: 40
INSTANCE_VOLUME_SIZE=

# Folder the IDE opens on load, and the clone target for REPO_URL.
# Default: /workshop
HOME_FOLDER=

# ---------------------------------------------------------------------------
# Repo to clone onto the instance
# ---------------------------------------------------------------------------

# Repository cloned into /workshop by default.
REPO_URL=https://github.com/neo4j-partners/neo4j-aws-graphrag-workshop.git

# Branch or tag to check out.
REPO_BRANCH=main
