# Scratch. Planning notes, run evidence, and executed-notebook output. Nothing
# in here is part of the workshop or its tooling, and nothing outside it should
# reference a path inside it.
workfolder/

assets/*
!assets/README.md

.claude/*
.idea/
.vscode/

# Environment. Never commit credentials.
# CONFIG.txt is tracked, because it ships as the placeholder template a
# participant fills in. The entry below therefore does nothing on its own,
# since .gitignore has no effect on a tracked file. It is here so that a copy
# made anywhere else in the tree stays out, and as the reminder that a
# filled-in CONFIG.txt must never be committed.
.env
*.env.local
notebooks/.env
CONFIG.txt

# Own-account Code Editor access URLs contain bearer tokens.
environment/own-account/*-roster.csv

# Retired Workshop Studio files. They live in the Workshop Studio repo, not here.
contentspec.yaml
FACILITATOR_GUIDE.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Jupyter outputs (strip before committing with: jupyter nbconvert --clear-output)
.ipynb_checkpoints/

# Corpus extracted from hotel-faqs.zip at run time, not a source artifact
notebooks/*/data/

# Large data files (go in assets/ S3 bucket, not repo)
notebooks/*.index
notebooks/*.json.bak
notebooks/faqs_*.json
notebooks/faqs_*.index

# Module 5 build context staging. `workshop-*.whl` and `reservation_command.py`
# are staged into runtime_app/ by 5.1_deploy.ipynb immediately before the
# container build, because Docker cannot reach outside its build context. The
# originals are the versioned copies; these are regenerated every run.
notebooks/05-agentcore-deploy/runtime_app/workshop-*.whl
notebooks/05-agentcore-deploy/runtime_app/reservation_command.py
notebooks/05-agentcore-deploy/runtime_app/.bedrock_agentcore.yaml
notebooks/05-agentcore-deploy/runtime_app/Dockerfile.bak

# Build artifacts from `uv build --wheel` on notebooks/workshop/pyproject.toml
# (also produced by the Module 4.1 Lambda build, in a temp directory instead).
notebooks/workshop/build/
notebooks/workshop/workshop.egg-info/

# Generated by the Antora build from site/content and site/images.
site/modules/
site/build/
site/node_modules/

# macOS
.DS_Store
